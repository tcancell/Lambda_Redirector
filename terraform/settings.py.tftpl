# Generated by Terraform during Lambda@Edge packaging.
# Lambda@Edge does not support custom environment variables, so deploy-time
# configuration is embedded into the published function version.

CONFIG_BUCKET = ${jsonencode(config_bucket)}
CONFIG_KEY = ${jsonencode(config_key)}
CONFIG_REGION = ${jsonencode(config_region)}
CONFIG_CHECK_INTERVAL_SECONDS = ${config_check_interval_seconds}
FALLBACK_BEHAVIOR = ${jsonencode(fallback_behavior)}
FALLBACK_STATUS_CODE = ${fallback_status_code}
FALLBACK_BODY = ${jsonencode(fallback_body)}
REDIRECT_CACHE_SECONDS = ${redirect_cache_seconds}
TRUSTED_EDGE_HEADER_NAME = "x-redirect-edge-token"
TRUSTED_EDGE_HEADER_VALUE = ${jsonencode(edge_header_secret)}
ALLOWED_REDIRECT_HOSTS = ${jsonencode(allowed_redirect_hosts_csv)}
REQUIRE_HTTPS_REDIRECT_TARGETS = ${require_https_redirect_targets}
MAX_REDIRECT_CONFIG_BYTES = ${max_redirect_config_bytes}
ENABLE_DIAGNOSTIC_HEADERS = ${enable_diagnostic_headers}
